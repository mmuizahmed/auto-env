{
  "name": "load-my-env",
  "version": "1.0.1",
  "description": "Load .env into process.env on import — no .config() call",
  "license": "MIT",
  "author": "Muiz Ahmed <muizahmedarain@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmuizahmed/load-my-env.git"
  },
  "homepage": "https://github.com/mmuizahmed/load-my-env#readme",
  "bugs": {
    "url": "https://github.com/mmuizahmed/load-my-env/issues"
  },
  "keywords": [
    "dotenv",
    "env",
    ".env",
    "environment",
    "auto",
    "config"
  ],
  "engines": {
    "node": ">=12"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  }
}
